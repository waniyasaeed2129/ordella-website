@model IEnumerable<CustomerOrder>
@{ViewData["Title"]="Orders";}
<div class="container py-5"><h1>Orders</h1><p class="text-muted">Review customer requests and update order progress.</p>@foreach(var o in Model){<div class="card border-0 shadow-sm p-4 mb-3"><div class="d-flex justify-content-between flex-wrap"><div><strong>Order #@o.OrderNumber</strong><div>@o.CustomerName · @o.CustomerEmail · @o.CustomerPhone</div><small class="text-muted">@o.CreatedAt.ToLocalTime()</small></div><strong>Rs. @o.Total.ToString("N0")</strong></div><ul class="mt-3">@foreach(var i in o.Items){<li>@i.ProductName × @i.Quantity — Rs. @i.UnitPrice.ToString("N0")</li>}</ul><form asp-action="UpdateStatus" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@o.Id"/><select name="status" class="form-select" style="max-width:220px"><option>Received</option><option>Confirmed</option><option>In Progress</option><option>Ready</option><option>Completed</option><option>Cancelled</option></select><button class="btn btn-dark">Update status</button><span class="badge bg-light text-dark align-self-center">Current: @o.Status</span></form></div>}</div>
