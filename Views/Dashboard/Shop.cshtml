@model Shop
@{ViewData["Title"]="Shop profile";}
<div class="container py-5"><h1>Shop profile</h1><p class="text-muted">Create your own standalone storefront and share its link.</p><form asp-action="Shop" method="post" class="form-panel"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Name" class="form-label">Shop name</label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div class="mb-3"><label asp-for="ContactEmail" class="form-label">Contact email</label><input asp-for="ContactEmail" class="form-control"/></div><div class="mb-3"><label asp-for="BannerUrl" class="form-label">Banner image URL (optional)</label><input asp-for="BannerUrl" class="form-control"/></div><button class="btn btn-dark rounded-pill px-4">Save shop</button> <a asp-action="Index" class="btn btn-link">Cancel</a></form></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
