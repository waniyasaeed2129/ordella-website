@{ViewData["Title"]="Seller dashboard";Shop? shop=ViewBag.Shop;var orders=(IEnumerable<CustomerOrder>)ViewBag.Orders;}
<section class="container py-5"><div class="d-flex justify-content-between flex-wrap gap-3 align-items-center"><div><span class="eyebrow">SELLER SPACE</span><h1>Your dashboard</h1><p class="text-muted">Manage your storefront and incoming orders.</p></div><a class="btn btn-dark rounded-pill px-4" asp-action="Shop">@(shop==null?"Set up your shop":"Edit shop")</a></div>@if(TempData["Message"]!=null){<div class="alert alert-success">@TempData["Message"]</div>}<div class="row g-3 my-3"><div class="col-md-4"><div class="stat"><small>SHOP STATUS</small><h3>@(shop==null?"Not set up":shop.IsPublished?"Published":"Draft")</h3></div></div><div class="col-md-4"><div class="stat"><small>STORE LINK</small><h3 class="fs-6">@(shop==null?"Create your shop first":Url.Action("Store","Home",new{slug=shop.Slug},Context.Request.Scheme))</h3></div></div><div class="col-md-4"><div class="stat"><small>QUICK ACTIONS</small><div class="d-flex gap-2 mt-2"><a asp-action="Products">Products</a><a asp-action="Orders">Orders</a></div></div></div></div>@if(shop!=null){<div class="card border-0 shadow-sm p-4"><div class="d-flex justify-content-between flex-wrap gap-2"><div><h4>@shop.Name</h4><p class="text-muted">@shop.Description</p></div><form asp-action="TogglePublish" method="post"><button class="btn btn-outline-dark rounded-pill">@(shop.IsPublished?"Unpublish shop":"Publish shop")</button></form></div><a target="_blank" asp-controller="Home" asp-action="Store" asp-route-slug="@shop.Slug">Preview storefront</a></div>}</section>
