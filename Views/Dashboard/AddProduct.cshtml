@model Product
@{ViewData["Title"]="Add product";}
<div class="container py-5"><h1>Add a product</h1><form asp-action="AddProduct" method="post" class="form-panel"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div><div class="mb-3"><label asp-for="Price" class="form-label"></label><input asp-for="Price" class="form-control"/><span asp-validation-for="Price" class="text-danger"></span></div><div class="mb-3"><label asp-for="Category" class="form-label"></label><input asp-for="Category" class="form-control"/></div><div class="mb-3"><label asp-for="ImageUrl" class="form-label">Image URL (optional)</label><input asp-for="ImageUrl" class="form-control"/></div><div class="form-check mb-3"><input asp-for="IsAvailable" class="form-check-input"/><label asp-for="IsAvailable" class="form-check-label"></label></div><button class="btn btn-dark rounded-pill">Save product</button> <a asp-action="Products" class="btn btn-link">Cancel</a></form></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
