@model IEnumerable<Product>
@{ViewData["Title"]="Products";}
<div class="container py-5"><div class="d-flex justify-content-between align-items-center"><div><h1>Products</h1><p class="text-muted">Add and manage the items in your shop.</p></div><a asp-action="AddProduct" class="btn btn-dark rounded-pill">Add product</a></div><div class="table-responsive mt-4"><table class="table align-middle"><thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Availability</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td><strong>@p.Name</strong><div class="small text-muted">@p.Description</div></td><td>@p.Category</td><td>Rs. @p.Price.ToString("N0")</td><td>@(p.IsAvailable?"Available":"Unavailable")</td><td><form asp-action="DeleteProduct" method="post"><input type="hidden" name="id" value="@p.Id"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>}</tbody></table></div></div>
