@model Shop
@{ViewData["Title"]=Model.Name;}
<section class="store-hero"><div class="container py-5"><span class="eyebrow">WELCOME TO</span><h1 class="display-4 fw-semibold">@Model.Name</h1><p class="lead">@Model.Description</p>@if(!string.IsNullOrWhiteSpace(Model.ContactEmail)){<p><a href="mailto:@Model.ContactEmail">Contact the shop</a></p>}</div></section><section class="container py-5"><div class="d-flex justify-content-between align-items-center mb-4"><div><span class="eyebrow">THE COLLECTION</span><h2>Available products</h2></div><span class="text-muted">@Model.Products.Count(p=>p.IsAvailable) items</span></div><div class="row g-4">@foreach(var p in Model.Products.Where(p=>p.IsAvailable)){<div class="col-sm-6 col-lg-4"><div class="product-card">@if(!string.IsNullOrEmpty(p.ImageUrl)){<img src="@p.ImageUrl" alt="@p.Name"/>}else{<div class="product-placeholder">Ordella</div>}<div class="p-3"><small class="text-muted">@p.Category</small><h5>@p.Name</h5><p class="text-muted">@p.Description</p><strong>Rs. @p.Price.ToString("N0")</strong></div></div></div>}</div>@if(Model.Products.Any(p=>p.IsAvailable)){<div class="text-center mt-5"><a class="btn btn-dark btn-lg rounded-pill px-5" asp-controller="Order" asp-action="Checkout" asp-route-shopId="@Model.Id">Place an order</a></div>}else{<p class="text-muted">This shop has no products available right now.</p>}</section>
